# Groups
dn: cn=employees,ou=groups,dc=corp,dc=local
objectClass: posixGroup
cn: employees
gidNumber: 1001
memberUid: alice
memberUid: bob

dn: cn=admins,ou=groups,dc=corp,dc=local
