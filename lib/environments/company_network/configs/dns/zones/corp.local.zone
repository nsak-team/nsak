$TTL 300
@   IN SOA dns.corp.local. admin.corp.local. (
            2024010101 ; serial
            3600       ; refresh
            900        ; retry
            604800     ; expire
            300 )      ; minimum TTL

; Name servers
@           IN NS   dns.corp.local.

; DMZ
dns         IN A    192.168.1.53
web         IN A    192.168.1.10
mail        IN A    192.168.1.25
smtp        IN A    192.168.1.25

; MX record
@           IN MX 10 mail.corp.local.

; Intranet
dc          IN A    10.10.0.10
ldap        IN A    10.10.0.10
fileserver  IN A    10.10.0.20
db          IN A    10.10.0.30
workstation IN A    10.10.0.100
siem        IN A    10.10.0.200
