<mxfile host="Electron" agent="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/28.2.5 Chrome/138.0.7204.251 Electron/37.6.1 Safari/537.36" version="28.2.5">
  <diagram name="Page-1" id="93mdE2ieNcs-ZzOcHShD">
    <mxGraphModel dx="1499" dy="2407" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n      actor User\n      participant Scenario as Multi-Agent Recon&lt;br/&gt;run()\n      participant A1 as Agent 1&lt;br/&gt;network_discovery\n      participant A2 as Agent 2&lt;br/&gt;enumerate_services\n      participant A3 as Agent 3&lt;br/&gt;assessment\n      participant Tools as LangChain Tools\n      participant Target as Target Network\n  \n      User-&gt;&gt;Scenario: nsak scenario run ai-reconnaissance-multi-agent\n      activate Scenario\n\n      Note over Scenario,A3: divide-and-conquer:&lt;br/&gt;each step is a fresh create_ai_agent() with its own context\n\n      Scenario-&gt;&gt;A1: create_ai_agent(response_format=NetworkDiscoveryTable)&lt;br/&gt;ainvoke(discovery prompt)\n      activate A1\n      loop ReAct loop\n          A1-&gt;&gt;Tools: host_configuration() / cli_tool(\&quot;nmap -sn ...\&quot;)\n          activate Tools\n          Tools-&gt;&gt;Target: discover subnets, hosts, services\n          Target--&gt;&gt;Tools: raw output\n          Tools--&gt;&gt;A1: result\n          deactivate Tools\n      end\n      Note right of A1: if structured_response is None&lt;br/&gt;fallback json.loads into NetworkDiscoveryTable\n      A1--&gt;&gt;Scenario: NetworkDiscoveryTable\n      deactivate A1\n\n      Scenario-&gt;&gt;A2: create_ai_agent(response_format=EnumerateServicesResult)&lt;br/&gt;ainvoke(enumerate prompt + discovery table)\n      activate A2\n      loop ReAct loop\n          A2-&gt;&gt;Tools: cli_tool(\&quot;nmap --script ...\&quot;) NSE\n          activate Tools\n          Tools-&gt;&gt;Target: enumerate discovered services\n          Target--&gt;&gt;Tools: NSE output\n          Tools--&gt;&gt;A2: result\n          deactivate Tools\n      end\n      A2--&gt;&gt;Scenario: EnumerateServicesResult\n      deactivate A2\n\n      Scenario-&gt;&gt;A3: create_ai_agent()&lt;br/&gt;ainvoke(assessment prompt + both tables)\n      activate A3\n      Note right of A3: reasons over both results&lt;br/&gt;no response_format\n      A3--&gt;&gt;Scenario: markdown assessment\n      deactivate A3\n\n      Note over Scenario: aggregate usage.tokens and&lt;br/&gt;tools_called over A1, A2, A3\n\n      Scenario--&gt;&gt;User: AIReconnaissanceScenarioResult&lt;br/&gt;(tables + assessment + tokens)\n      deactivate Scenario&quot;&#xa;}" id="AUQ31eZd9T10PhncQPlp-75">
