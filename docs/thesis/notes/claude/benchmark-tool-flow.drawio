<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Config -->
    <mxCell id="config" value="&lt;b&gt;Config&lt;/b&gt;&lt;br&gt;scenario · model · n runs"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;"
      vertex="1" parent="1">
      <mxGeometry x="300" y="40" width="240" height="60" as="geometry"/>
    </mxCell>

    <!-- BenchmarkManager -->
    <mxCell id="bm" value="&lt;b&gt;BenchmarkManager&lt;/b&gt;"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;"
      vertex="1" parent="1">
      <mxGeometry x="300" y="160" width="240" height="60" as="geometry"/>
    </mxCell>

    <!-- config to BM -->
    <mxCell id="e_cfg_bm" edge="1" source="config" target="bm" parent="1"
      style="edgeStyle=orthogonalEdgeStyle;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Loop dashed rectangle (visual only) -->
    <mxCell id="loop_rect" value=""
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#aaaaaa;dashed=1;dashPattern=8 4;strokeWidth=2;"
      vertex="1" parent="1">
      <mxGeometry x="70" y="280" width="720" height="240" as="geometry"/>
    </mxCell>

    <!-- Loop label -->
    <mxCell id="loop_label" value="repeat n times"
      style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontStyle=2;fontSize=11;fontColor=#888888;"
      vertex="1" parent="1">
      <mxGeometry x="86" y="286" width="120" height="20" as="geometry"/>
    </mxCell>

    <!-- Reset State -->
    <mxCell id="reset" value="Reset State"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
      vertex="1" parent="1">
      <mxGeometry x="100" y="355" width="140" height="60" as="geometry"/>
    </mxCell>

    <!-- AI Scenario -->
    <mxCell id="ai_sc" value="AI Scenario&lt;br&gt;&lt;i&gt;LangChain agent&lt;/i&gt;"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
      vertex="1" parent="1">
      <mxGeometry x="310" y="315" width="155" height="55" as="geometry"/>
    </mxCell>

    <!-- Static Scenario -->
    <mxCell id="static_sc" value="Static Scenario&lt;br&gt;&lt;i&gt;drill chain&lt;/i&gt;"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
      vertex="1" parent="1">
      <mxGeometry x="310" y="400" width="155" height="55" as="geometry"/>
    </mxCell>

    <!-- "or" label -->
    <mxCell id="or_label" value="or"
      style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=2;fontSize=11;fontColor=#999999;"
      vertex="1" parent="1">
      <mxGeometry x="375" y="370" width="30" height="20" as="geometry"/>
    </mxCell>

    <!-- BenchmarkRun swimlane container -->
    <mxCell id="brun" value="&lt;b&gt;BenchmarkRun&lt;/b&gt;"
      style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;"
      vertex="1" parent="1">
      <mxGeometry x="530" y="298" width="230" height="190" as="geometry"/>
    </mxCell>

    <!-- BenchmarkResult inside BenchmarkRun -->
    <mxCell id="bresult"
      value="&lt;b&gt;BenchmarkResult&lt;/b&gt;&lt;br&gt;duration&lt;br&gt;tokens (prompt + completion)&lt;br&gt;hosts · services · findings&lt;br&gt;&lt;i&gt;tokens = empty for static&lt;/i&gt;"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;"
      vertex="1" parent="brun">
      <mxGeometry x="15" y="40" width="200" height="130" as="geometry"/>
    </mxCell>

    <!-- BM to Reset -->
    <mxCell id="e_bm_reset" edge="1" source="bm" target="reset" parent="1"
      style="edgeStyle=orthogonalEdgeStyle;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Reset to AI -->
    <mxCell id="e_reset_ai" edge="1" source="reset" target="ai_sc" parent="1"
      style="edgeStyle=orthogonalEdgeStyle;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Reset to Static -->
    <mxCell id="e_reset_static" edge="1" source="reset" target="static_sc" parent="1"
      style="edgeStyle=orthogonalEdgeStyle;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- AI to BenchmarkRun -->
    <mxCell id="e_ai_brun" edge="1" source="ai_sc" target="brun" parent="1"
      style="edgeStyle=orthogonalEdgeStyle;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Static to BenchmarkRun -->
    <mxCell id="e_static_brun" edge="1" source="static_sc" target="brun" parent="1"
      style="edgeStyle=orthogonalEdgeStyle;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- BenchmarkReport -->
    <mxCell id="breport"
      value="&lt;b&gt;BenchmarkReport&lt;/b&gt;&lt;br&gt;mean · std-dev · all n runs aggregated"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;"
      vertex="1" parent="1">
      <mxGeometry x="275" y="575" width="270" height="65" as="geometry"/>
    </mxCell>

    <!-- BenchmarkRun to BenchmarkReport -->
    <mxCell id="e_brun_report" edge="1" source="brun" target="breport" parent="1"
      style="edgeStyle=orthogonalEdgeStyle;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Output: Markdown -->
    <mxCell id="out_md"
      value="Markdown report&lt;br&gt;&lt;i&gt;qualitative review&lt;/i&gt;"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;"
      vertex="1" parent="1">
      <mxGeometry x="70" y="710" width="175" height="60" as="geometry"/>
    </mxCell>

    <!-- Output: JSON -->
    <mxCell id="out_json"
      value="JSON file&lt;br&gt;&lt;i&gt;quantitative figures&lt;/i&gt;"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;"
      vertex="1" parent="1">
      <mxGeometry x="285" y="710" width="175" height="60" as="geometry"/>
    </mxCell>

    <!-- Output: stdout -->
    <mxCell id="out_stdout"
      value="stdout summary table&lt;br&gt;&lt;i&gt;printed to terminal&lt;/i&gt;"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;"
      vertex="1" parent="1">
      <mxGeometry x="500" y="710" width="175" height="60" as="geometry"/>
    </mxCell>

    <!-- BenchmarkReport to outputs -->
    <mxCell id="e_report_md" edge="1" source="breport" target="out_md" parent="1"
      style="edgeStyle=orthogonalEdgeStyle;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="e_report_json" edge="1" source="breport" target="out_json" parent="1"
      style="edgeStyle=orthogonalEdgeStyle;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="e_report_stdout" edge="1" source="breport" target="out_stdout" parent="1"
      style="edgeStyle=orthogonalEdgeStyle;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>
